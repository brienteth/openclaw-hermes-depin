# Default Hermes Model (e.g., hermes3:8b, llama3.1:8b)
HERMES_MODEL=hermes3:8b

# Optional: Connect directly to MYCA Genesis Spore Node for maximized rewards
# MYCA_NODE_RPC=http://localhost:8080/v1
# MYCA_SPORE_NODE_ADDRESS=0xYourWalletAddressHere

# Ponds Family Community Token Address (Support open-source development)
# COMMUNITY_TOKEN_ADDRESS=0x...
